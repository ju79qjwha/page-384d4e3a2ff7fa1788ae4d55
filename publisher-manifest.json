r;font-weight: 700}\n\n.plans-table-wrapper {overflow-x: auto}\n\n.plans-table {width: 100%;border-collapse: separate;border-spacing: 0;background-color: var(--panel-bg);border-radius: var(--card-radius);overflow: hidden;box-shadow: 0 10px 30px rgba(0,0,0,0.3)}\n\n.plans-table th,\n.plans-table td {padding: 1.5rem;text-align: center;border-bottom: 1px solid rgba(255, 255, 255, 0.05)}\n\n.plans-table th {background-color: rgba(0,0,0,0.2);color: var(--text-bright);font-size: 1.2rem}\n\n.plans-table td:first-child,\n.plans-table th:first-child {text-align: left}\n\n.plans-table tr:last-child td {border-bottom: none}\n\n.price {font-size: 1.5rem;color: var(--accent);font-weight: bold}\n\n.annual {font-size: 0.85rem;color: var(--text-main);margin-top: 0.25rem}\n\n.featured-tag {background: var(--accent);color: var(--bg-color);padding: 0.2rem 0.6rem;border-radius: 4px;font-size: 0.75rem;font-weight: bold;margin-left: 0.5rem;vertical-align: middle}\n\n.features-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));gap: 2rem}\n\n.feature-card {background-color: var(--panel-bg);border-radius: var(--card-radius);padding: 2.5rem;box-shadow: 0 10px 30px rgba(0,0,0,0.3);transition: var(--transition)}\n\n.feature-card:hover {transform: translateY(-5px);box-shadow: 0 15px 35px rgba(102, 252, 241, 0.1)}\n\n.feature-card h3 {color: var(--text-bright);margin-bottom: 1rem;font-size: 1.3rem}\n\n.faq-container {display: grid;grid-template-columns: 1fr;gap: 2rem}\n\n@media (min-width: 768px) {\n  .faq-container {grid-template-columns: 1fr 1fr}\n}\n\n.faq-item {background-color: var(--panel-bg);border-radius: var(--card-radius);padding: 2rem;box-shadow: 0 10px 30px rgba(0,0,0,0.3)}\n\n.faq-item h3 {color: var(--accent);margin-bottom: 0.75rem;font-size: 1.1rem}\n\nfooter {text-align: center;padding: 4rem 0;border-top: 1px solid rgba(255, 255, 255, 0.05);color: var(--text-main);font-size: 0.9rem}\n</style><main>\n  <header>\n    <div class=\"hero-grid\">\n      <div class=\"hero-left\">\n        <h1><span>三斤云</span><br>新一代网络加速</h1>\n        <p>稳定、高速、安全的网络连接解决方案。专为现代数据交互与流媒体访问设计，提供流畅体验。</p>\n        <div class=\"hero-nav-tags\">\n          <a href=\"#plans\">套餐价格</a>\n          <a href=\"#features\">服务特性</a>\n          <a href=\"#faq\">常见问题</a>\n        </div>\n      </div>\n      <div class=\"hero-panel\">\n        <h3>系统状态</h3>\n        <ul>\n          <li><span>节点在线率</span> <span>99.9%</span></li>\n          <li><span>当前延迟</span> <span>极低</span></li>\n          <li><span>专线支持</span> <span>IPLC / IEPL</span></li>\n          <li><span>协议支持</span> <span>全平台兼容</span></li>\n        </ul>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"plans\">\n    <h2>选择适合您的套餐</h2>\n    <div class=\"plans-table-wrapper\">\n      <table class=\"plans-table\">\n        <thead>\n          <tr>\n            <th>套餐类型</th>\n            <th>基础版</th>\n            <th>旗舰版 <span class=\"featured-tag\">推荐</span></th>\n            <th>团队版</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td><strong>价格</strong></td>\n            <td>\n              <div class=\"price\">¥15/月</div>\n              <div class=\"annual\">按年付仅需 ¥150/年</div>\n            </td>\n            <td>\n              <div class=\"price\">¥35/月</div>\n              <div class=\"annual\">按年付仅需 ¥350/年</div>\n            </td>\n            <td>\n              <div class=\"price\">¥85/月</div>\n              <div class=\"annual\">按年付仅需 ¥850/年</div>\n            </td>\n          </tr>\n          <tr>\n            <td><strong>每月流量</strong></td>\n            <td>100GB 极速流量</td>\n            <td>300GB 极速流量</td>\n            <td>1000GB 极速流量</td>\n          </tr>\n          <tr>\n            <td><strong>设备在线</strong></td>\n            <td>支持 3 台设备</td>\n            <td>支持 5 台设备</td>\n            <td>支持 20 台设备</td>\n          </tr>\n          <tr>\n            <td><strong>核心权益</strong></td>\n            <td>解锁基础流媒体<br>普通线路节点池</td>\n            <td>全节点原生流媒体解锁<br>IPLC 专线游戏加速优化<br>7x24 优先工单支持</td>\n            <td>VIP 专属高带宽节点<br>支持企业定制路由<br>专属客户经理服务</td>\n          </tr>\n          <tr>\n            <td><strong>操作</strong></td>\n            <td><a href=\"#\">立即订购 →</a></td>\n            <td><a href=\"#\">立即订购 →</a></td>\n            <td><a href=\"#\">立即订购 →</a></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"features\">\n    <h2>核心优势</h2>\n    <div class=\"features-grid\">\n      <div class=\"feature-card\">\n        <h3>极速专线</h3>\n        <p>采用高质量 IPLC 与 IEPL 专线网络，有效降低延迟，保障高峰期数据传输的稳定性与流畅度。</p>\n      </div>\n      <div class=\"feature-card\">\n        <h3>多端兼容</h3>\n        <p>完美支持主流操作系统与各类客户端，配置简单，一键接入，随时随地享受高速网络服务。</p>\n      </div>\n      <div class=\"feature-card\">\n        <h3>安全隐私</h3>\n        <p>采用先进的加密传输协议，严格保护用户的网络数据与隐私安全，使用更放心。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <h2>常见问题</h2>\n    <div class=\"faq-container\">\n      <div class=\"faq-item\">\n        <h3>如何开始使用三斤云？</h3>\n        <p>注册账号后，选择适合的套餐并完成订购，即可在用户中心获取订阅链接，导入至支持的客户端即可使用。</p>\n      </div>\n      <div class=\"faq-item\">\n        <h3>支持哪些客户端？</h3>\n        <p>我们支持主流的各类通用网络客户端，覆盖 Windows、macOS、iOS、Android 等多个平台。</p>\n      </div>\n      <div class=\"faq-item\">\n        <h3>套餐流量如何计算？</h3>\n        <p>流量按自然月重置，双向计算。未用完的流量不累计至下个月，订购新套餐或续费会刷新流量额度。</p>\n      </div>\n      <div class=\"faq-item\">\n        <h3>是否提供技术支持？</h3>\n        <p>我们提供全天候工单支持服务，旗舰版及团队版用户更可享受优先响应与专属客户经理服务。</p>\n      </div>\n    </div>\n  </section>\n\n  <footer>\n    <p>© 三斤云 版权所有。保留所有权利。</p>\n  </footer>\n</main>",
